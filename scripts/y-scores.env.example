# Preserve on upgrades. Change these for this device, then restart y-scores.
Y_SCORES_PORT=8080
Y_SCORES_BIND=0.0.0.0
Y_SCORES_API=https://y-sports.xyz/api-next
# Account pairing/status API uses its own configured trusted origin. Display stays local.
Y_SCORES_PLATFORM_API=https://y-sports.xyz/api-next
# Local development only: Y_SCORES_ALLOW_HTTP_PLATFORM=1
# Additional explicitly trusted local hostnames, comma-separated (no URL/port/wildcard).
# Y_SCORES_ALLOWED_HOSTS=scoreboard.example.local
# Optional network helper requires the installed country's regulatory setting.
# Y_SCORES_WIFI_COUNTRY=HU
# Y_SCORES_WIFI_INTERFACE=wlan0
# parallel: independent bonnet ports; chain: three panels from bonnet port 1.
Y_SCORES_TOPOLOGY=parallel
# Each port (parallel) or chain position (chain)'s logical tile (left=0, center=1, right=2), and rotation.
Y_SCORES_ORDER=2,1,0
Y_SCORES_ROTATE=180,0,0
Y_SCORES_PINOUT=Active3BGR

# Color-depth/refresh tradeoff. For steadier chain refresh use 6 and 1.
Y_SCORES_COLOR_PLANES=10
Y_SCORES_TEMPORAL_PLANES=2
